# Copy to .env at the repository root. Never commit real credentials.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Use the host's direct or session-mode PostgreSQL URL, without URL query parameters.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Optional migration role/endpoint; defaults to DATABASE_URL.
# MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Optional PEM CA certificate path, relative to repository root or absolute.
# DATABASE_CA_FILE=/absolute/path/to/provider-ca.pem

# Defaults to true. Set false explicitly only in staging to skip server verification.
# TLS encryption remains enabled; applies to API and migration connections.
DATABASE_TLS_VERIFY=true
