    "recover-administrator": "pnpm --filter @servicelane/api recover-administrator",
    "test:access": "pnpm --filter @servicelane/api test:access",
    "test:menu": "pnpm --filter @servicelane/api test:menu",
    "test:kitchen": "pnpm --filter @servicelane/api test:kitchen",
    "test:orders": "pnpm --filter @servicelane/api test:orders",
    "check:architecture": "pnpm --filter @servicelane/api check:architecture",
    "test:architecture": "pnpm --filter @servicelane/api test:architecture",
    "test:billing": "pnpm --filter @servicelane/api test:billing"
  }
