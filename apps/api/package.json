{
  "name": "@servicelane/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "db:migrate": "node --env-file-if-exists=../../.env dist/infrastructure/database/migrate.js",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "dev": "tsc-watch -p tsconfig.json --noEmitOnError --onSuccess \"node --env-file-if-exists=../../.env dist/main.js\"",
    "provision-installation": "node --env-file-if-exists=../../.env dist/operator/provision-installation.js",
    "test:bootstrap": "tsc -p tsconfig.json --outDir dist/ba01-check --sourceMap false && node --test tests/bootstrap.test.mjs",
    "recover-administrator": "node --env-file-if-exists=../../.env dist/operator/recover-administrator.js",
    "test:access": "tsc -p tsconfig.json --outDir dist/ba02-check --sourceMap false && node --test tests/credentials.test.mjs tests/access.test.mjs tests/access-http.test.mjs tests/authorized-operation.test.mjs tests/recovery.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/config": "12.0.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3",
    "drizzle-kit": "0.31.11",
    "tsc-watch": "7.2.1"
  }
}
